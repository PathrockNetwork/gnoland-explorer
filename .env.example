# ── gno.land RPC (Tendermint2) ──────────────────────────────────────────────
# Comma-separated, in priority order. Used for commit signatures, validator
# sets and live state (balances, realm renders, source files). The Pathrock
# archive keeps all state; rpc.gno.land prunes it below ~240,000 and is the failover.
RPC_URLS=https://gnoland.archive.pathrocknetwork.org,https://rpc.gno.land
# Expected chain id; the indexer refuses to start against anything else.
# CHAIN_ID=gnoland-1
# Request budget per second: indexer / API (separate processes, separate buckets).
# RPC_RPS=10
# API_RPC_RPS=10

# ── tx-indexer (GraphQL) ────────────────────────────────────────────────────
# Pathrock's gnolang/tx-indexer instance: decoded blocks and transactions.
# The official one at https://indexer.gno.land/graphql/query serves the same data.
TX_INDEXER_URL=https://indexer.gnoland.pathrocknetwork.org/graphql/query
# TX_INDEXER_RPS=5

# ── Postgres ────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://gnoland:CHANGE_ME@localhost:5432/gnoland_explorer

# ── Indexer ─────────────────────────────────────────────────────────────────
# Blocks and transactions are kept from genesis. Commit signatures (uptime)
# cost one RPC request per block, so only the newest SIGNATURE_DEPTH blocks
# are read (~3.5s each: 100,000 ≈ 4 days). "all" reads back to height 1.
# SIGNATURE_DEPTH=100000
# Blocks per tx-indexer page while catching up (the indexer caps at 10,000).
# BLOCK_PAGE=2000
# Commit-signature blocks per RPC batch.
# SIGNATURE_BATCH=10

# ── API ─────────────────────────────────────────────────────────────────────
API_PORT=3002
# Loopback by default; the public facade is Caddy (deploy/Caddyfile.gnoland).
# API_HOST=127.0.0.1
